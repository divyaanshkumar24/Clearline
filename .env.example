# Copy this file to .env and fill in real values:
#   cp .env.example .env

# Hugging Face access token.
# Required for downloading gated pyannote.audio speaker diarization models
# (e.g. pyannote/speaker-diarization) and other gated/private models on the Hub.
# Get one at: https://huggingface.co/settings/tokens
# You must also accept the model terms on the model's Hugging Face page
# (e.g. https://huggingface.co/pyannote/speaker-diarization-3.1) before the token will work.
HF_TOKEN=

# NVIDIA API key.
# Required for generating call recommendations in stage3_recommendations — used to call
# an NVIDIA NIM-hosted Nemotron model (nvidia/llama-3.1-nemotron-70b-instruct by default;
# see MODEL in stage3_recommendations/recommendation.py) via NVIDIA's OpenAI-compatible
# chat completions API.
# Get a free-tier key at: https://build.nvidia.com/
NVIDIA_API_KEY=
