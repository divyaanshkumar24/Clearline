# Copy to .env.local for local development:
#   cp .env.local.example .env.local

# Base URL of the Clearline backend (FastAPI/uvicorn). Read only by server-side
# code (app/api/calls/route.ts) — never sent to the browser. Defaults to the
# backend's local dev port if unset.
BACKEND_API_URL=http://localhost:8000
